import {
  "kawaz/shimux/src/core",
  "kawaz/shimux/src/shim/tmux",
  "kawaz/shimux/src/terminal/ghostty",
  "kawaz/shimux/src/wrapper",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

supported_targets = "native"

options(
  "is-main": true,
  link: { "native": { "cc-link-flags": "-Lffi/target/release -lshimux_ffi" } },
)
